# Route the @holepunchto scope to GitHub Packages (private registry).
# Used for BOTH publishing this package and installing it in a consumer project.
# Auth is read from the GITHUB_TOKEN env var — NO token is ever written to this file.
#   publish: GITHUB_TOKEN needs scope `write:packages` (+ repo)
#   install: GITHUB_TOKEN needs scope `read:packages`
@holepunchto:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
always-auth=true
