# Auth mapping read at publish time (npm reads .npmrc from the publish cwd, not the repo root).
# npm strips .npmrc from the published tarball, so this never ships. No token on disk —
# auth comes from the GITHUB_TOKEN env var (needs write:packages to publish).
@holepunchto:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
always-auth=true
