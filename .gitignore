# Nothing here is needed to run `npm run build`, `bash verification/run-all.sh`,
# or to read the READMEs. If a pattern would hide something a fresh clone needs
# to build or understand the repo, it does not belong in this file.

# ---- build output & dependencies (regenerated by npm i / npm run build) ----
node_modules/
dist/
build/
out/
*.tgz
*.tsbuildinfo

# ---- tool & bundler caches ----
.cache/
.npm/
.turbo/
.parcel-cache/
.esbuild/
.eslintcache
.rollup.cache/

# ---- test / coverage artifacts ----
coverage/
.nyc_output/
test-results/
*.lcov

# ---- local env & secrets (never commit; .npmrc reads $GITHUB_TOKEN at runtime) ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- logs & crash dumps ----
*.log
logs/
npm-debug.log*
yarn-error.log*
.p2plog/

# ---- editor / IDE local state ----
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ---- OS junk ----
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini
._*

# ---- scratch / temp ----
tmp/
temp/
scratch/
*.orig
*.bak
*.rej

# ---- Python venvs (occasionally used by ad-hoc analysis scripts) ----
.venv/
__pycache__/

# ---- Claude Code: local, per-developer state ----
# Shared config (.claude/settings.json, committed skills/commands) stays tracked.
.claude/settings.local.json
.claude/local/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude/projects/
.claude/history.jsonl
CLAUDE.local.md

# ---- rebrand.sh working files ----
# scripts/rebrand.sh itself IS tracked — it is the fork's upstream-sync tool.
scripts/rebrand.local.sh
scripts/rebrand.*.local.sh
*.rebrand.bak
